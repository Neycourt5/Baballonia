<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>AnyCPU;x64</Platforms>
    <Version>3.2.1</Version>
    <AssemblyVersion>3.2.1.0</AssemblyVersion>
    <FileVersion>3.2.1.0</FileVersion>
    <InformationalVersion>3.2.1-local-baballonia-home-fork</InformationalVersion>
    <ModulePackageName>VRCFaceTracking.Baballonia-3.2.1-local.zip</ModulePackageName>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="BabbleLogo.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="BabbleEyeLogo.png" />
    <None Remove="BabbleFaceLogo.png" />
    <EmbeddedResource Include="BabbleFaceLogo.png" />
    <None Update="module.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="BabbleConfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VRCFaceTracking\VRCFaceTracking.Core\VRCFaceTracking.Core.csproj" />
    <ProjectReference Include="..\VRCFaceTracking\VRCFaceTracking.SDK\VRCFaceTracking.SDK.csproj" />
  </ItemGroup>

    <!-- Make module .zip -->
  <Target Name="ZipFiles" AfterTargets="AfterBuild">
    <PropertyGroup>
      <TempZipFolder>$(OutputPath)temp_zip</TempZipFolder>
    </PropertyGroup>
    
    <ItemGroup>
      <FilesToZip Include="$(OutputPath)VRCFaceTracking.Baballonia.dll" />
      <FilesToZip Include="$(OutputPath)BabbleConfig.json" />
      <FilesToZip Include="$(OutputPath)module.json" />
    </ItemGroup>
    
    <!-- Delete only this version's intermediate package before recreating it. -->
    <Delete Files="$(OutputPath)$(ModulePackageName)" ContinueOnError="true" />
    
    <!-- Create temp directory -->
    <MakeDir Directories="$(TempZipFolder)" />
    
    <!-- Copy files to temp directory -->
    <Copy SourceFiles="@(FilesToZip)" DestinationFolder="$(TempZipFolder)" />
    
    <!-- Create zip from temp directory -->
    <ZipDirectory SourceDirectory="$(TempZipFolder)" 
                  DestinationFile="$(OutputPath)$(ModulePackageName)" />
    
    <!-- Clean up temp directory -->
    <RemoveDir Directories="$(TempZipFolder)" />
  </Target>
  

</Project>
