<UserControl
    d:DesignHeight="800"
    d:DesignWidth="800"
    mc:Ignorable="d"
    xmlns:splitViewPane="clr-namespace:Baballonia.ViewModels.SplitViewPane"
    x:Class="Baballonia.Views.DebugView"
    x:DataType="splitViewPane:DebugViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer>
    <StackPanel Classes="Page" Spacing="12">
      <TextBlock Text="Eye issue diagnosis" FontSize="18" FontWeight="SemiBold" />
      <TextBlock Text="{Binding EyeTraceStatus}" TextWrapping="Wrap" />
      <WrapPanel>
        <Button Margin="0,0,8,8" Content="Start eye trace" Command="{Binding StartEyeTraceCommand}" />
        <Button Margin="0,0,8,8" Content="Mark eye issue" Command="{Binding MarkEyeIssueCommand}" />
        <Button Margin="0,0,8,8" Content="Stop eye trace" Command="{Binding StopEyeTraceCommand}" />
      </WrapPanel>
      <TextBlock Classes="Header" Margin="0,10,0,-6" Text="Performance metrics" />

      <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" Text="UI Render thread" />
          <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding RenderFps, StringFormat='{}{0:F1} fps'}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" Text="UI data thread" />
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding UiLoopFps, StringFormat='{}{0:F1} fps'}" />

          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" Text="Eye inference" />
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding EyeInferenceFps, StringFormat='{}{0:F1} fps'}" />

          <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" Text="Mouth inference" />
          <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding FaceInferenceFps, StringFormat='{}{0:F1} fps'}" />
        </Grid>
      </Border>

      <TextBlock Classes="Header" FontSize="18" Text="Thread CPU Usage" />
      <TextBlock Opacity="0.7"
                 Text="{Binding ProcessCpuPercent, StringFormat='Process: {0:F0}% x 1 core'}" />
      <TextBlock Opacity="0.7" Margin="0,-4,0,0"
                 Text="{Binding ProcessorCount, StringFormat='{}{0} logical cores'}" />
      <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16">
        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
            <TextBlock Grid.Column="0" FontWeight="SemiBold" Opacity="0.6" Text="Thread" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold" Opacity="0.6" Text="CPU" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Threads}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="splitViewPane:ThreadCpuRow">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" FontWeight="SemiBold"
                             Text="{Binding CpuPercent, StringFormat='{}{0:F1}%'}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Classes="Header" FontSize="18" Margin="0,10,0,-6" Text="Eye pipeline stages (avg)" />
      <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" Text="Capture + corruption check" />
          <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding EyeCaptureMs, StringFormat='{}{0:F2} ms'}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" Text="Transform + collect" />
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding EyeTransformMs, StringFormat='{}{0:F2} ms'}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" Text="Convert + inference" />
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding EyeInferenceMs, StringFormat='{}{0:F2} ms'}" />
          <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" Text="Filter + post" />
          <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding EyePostMs, StringFormat='{}{0:F2} ms'}" />
          <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4" Text="Personalized correction" />
          <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding EyeCorrectMs, StringFormat='{}{0:F2} ms'}" />
        </Grid>
      </Border>

      <TextBlock Classes="Header" FontSize="18" Margin="0,10,0,-6" Text="Mouth pipeline stages (avg)" />
      <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" Text="Capture" />
          <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding FaceCaptureMs, StringFormat='{}{0:F2} ms'}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" Text="Transform" />
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding FaceTransformMs, StringFormat='{}{0:F2} ms'}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" Text="Convert + inference" />
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding FaceInferenceMs, StringFormat='{}{0:F2} ms'}" />
          <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" Text="Filter + post" />
          <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                     Text="{Binding FacePostMs, StringFormat='{}{0:F2} ms'}" />
        </Grid>
      </Border>

      <TextBlock Classes="Header" FontSize="18" Margin="0,10,0,-6" Text="Eye output (live)" />
      <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16">
        <StackPanel Spacing="2">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Margin="0,4" Text="Widen / squint source" />
            <TextBlock Grid.Column="1" Margin="0,4" FontWeight="SemiBold" Text="{Binding EyeShapeSource}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Margin="0,4" Text="Eye coupling" />
            <TextBlock Grid.Column="1" Margin="0,4" FontWeight="SemiBold" Text="{Binding EyeSync}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Margin="0,4" Text="BlinkGuard" />
            <TextBlock Grid.Column="1" Margin="0,4" FontWeight="SemiBold" Text="{Binding EyeBlinkGuard}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Margin="0,4" Text="Personalized correction" />
            <TextBlock Grid.Column="1" Margin="0,4" FontWeight="SemiBold" Text="{Binding EyeCorrector}" />
          </Grid>

          <TextBlock FontWeight="SemiBold" Margin="0,8,0,2" Opacity="0.6" Text="Left" />
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" Text="Openness (calibrated)" />
            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="SemiBold" Text="{Binding LeftOpenness}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" Text="Shapes" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" FontWeight="SemiBold" Text="{Binding LeftShapes}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" Text="Gaze" />
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" FontWeight="SemiBold" Text="{Binding LeftGaze}" />
          </Grid>

          <TextBlock FontWeight="SemiBold" Margin="0,8,0,2" Opacity="0.6" Text="Right" />
          <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" Text="Openness (calibrated)" />
            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="SemiBold" Text="{Binding RightOpenness}" />
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" Text="Shapes" />
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" FontWeight="SemiBold" Text="{Binding RightShapes}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" Text="Gaze" />
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" FontWeight="SemiBold" Text="{Binding RightGaze}" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="Header" FontSize="18" Margin="0,10,0,-6" Text="Camera recovery" />
      <Border
          Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
          CornerRadius="8"
          Padding="16">
        <StackPanel Spacing="2">
          <ItemsControl ItemsSource="{Binding CameraStates}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="splitViewPane:CameraStateRow">
                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" />
                  <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding State}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
            <TextBlock Grid.Column="0" Text="Reconnects this session" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding ReconnectCount}" />
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Corrupt eye frames dropped" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding CorruptFrames}" />
          </Grid>
        </StackPanel>
      </Border>

      <TextBlock Classes="Header" FontSize="18" Margin="0,10,0,-6" Text="Cameras" />
      <ItemsControl ItemsSource="{Binding Cameras}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="splitViewPane:CameraRow">
            <Border
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8"
                Margin="0,0,0,12"
                Padding="16">
              <StackPanel>
                <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" Text="{Binding Name}" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4" Text="Delivered (measured)" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                             Text="{Binding DeliveredFps, StringFormat='{}{0:F1} fps'}" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4" Text="Last frame age" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                             Text="{Binding FrameAge}" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4" Text="Dropped (Last 60 seconds)" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                             Text="{Binding DroppedSummary}" />

                  <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,4" Text="Negotiated (driver)" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                             Text="{Binding NegotiatedFps, StringFormat='{}{0:F0} fps'}" />

                  <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,4" Text="Resolution" />
                  <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                             Text="{Binding Resolution}" />

                  <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,4" Text="Pixel format" />
                  <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"
                             Text="{Binding Format}" />
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
