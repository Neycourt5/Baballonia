<UserControl
    x:Class="Baballonia.Views.PersonalizationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Baballonia.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:splitViewPane="clr-namespace:Baballonia.ViewModels.SplitViewPane"
    d:DesignHeight="900"
    d:DesignWidth="800"
    x:DataType="splitViewPane:PersonalizationViewModel"
    mc:Ignorable="d">
  <!--
    Strings are intentionally literal rather than RESX entries. This is a fork-local feature and
    Assets/Resources.resx is Crowdin-managed upstream, so adding keys would conflict on every rebase
    while the feature is still moving.
  -->
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12">

      <TextBlock Classes="Header" Text="Personalize My Face" />
      <TextBlock
          MaxWidth="640"
          HorizontalAlignment="Left"
          Opacity="0.8"
          TextWrapping="Wrap"
          Text="Teach Baballonia what your face looks like on your camera. Record a few short sessions, press Train, and compare the result against the stock tracker. Everything stays on this computer." />

      <!-- ============================ SETUP ============================ -->
      <controls:ContentExample>
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" FontSize="16" FontWeight="SemiBold" Text="Setup" />
            <Button Grid.Column="1" Command="{Binding RefreshSetupCommand}" Content="Refresh" />
          </Grid>

          <!-- Two glyphs per row rather than a value converter: same result, no extra plumbing. -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock FontWeight="Bold" Foreground="#4CAF50" IsVisible="{Binding CameraReady}" Text="&#x2713;" />
            <TextBlock FontWeight="Bold" IsVisible="{Binding !CameraReady}" Opacity="0.5" Text="&#x2022;" />
            <TextBlock Text="{Binding CameraStatus}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock FontWeight="Bold" Foreground="#4CAF50" IsVisible="{Binding ToolsReady}" Text="&#x2713;" />
            <TextBlock FontWeight="Bold" IsVisible="{Binding !ToolsReady}" Opacity="0.5" Text="&#x2022;" />
            <TextBlock Text="{Binding ToolsStatus}" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock FontWeight="Bold" Foreground="#4CAF50" IsVisible="{Binding ModelReady}" Text="&#x2713;" />
            <TextBlock FontWeight="Bold" IsVisible="{Binding !ModelReady}" Opacity="0.5" Text="&#x2022;" />
            <TextBlock Text="{Binding ModelStatus}" TextWrapping="Wrap" />
          </StackPanel>

          <Button
              Command="{Binding SetUpToolsCommand}"
              Content="Set Up Training Tools"
              IsEnabled="{Binding !IsBusy}"
              IsVisible="{Binding CanSetUpTools}" />
          <TextBlock
              IsVisible="{Binding CanSetUpTools}"
              Opacity="0.7"
              TextWrapping="Wrap"
              Text="This downloads the training software (about 200 MB) once. It is installed outside Baballonia and never uploads anything." />
        </StackPanel>
      </controls:ContentExample>

      <!-- ========================== RECORDINGS ========================= -->
      <controls:ContentExample>
        <StackPanel Spacing="10">
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="Recordings" />

          <Grid ColumnDefinitions="120,Auto">
            <TextBlock Grid.Column="0" Text="Neutral" VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{Binding NeutralCount, StringFormat='{}{0} of 2 recorded'}" />
          </Grid>
          <Grid ColumnDefinitions="120,Auto">
            <TextBlock Grid.Column="0" Text="Speech" VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Text="{Binding SpeechCount, StringFormat='{}{0} of 2 recorded'}" />
          </Grid>

          <TextBlock Opacity="0.8" Text="{Binding RecordingAdvice}" TextWrapping="Wrap" />

          <Border
              Width="200"
              Height="200"
              HorizontalAlignment="Left"
              Background="#20000000"
              CornerRadius="4">
            <Image
                RenderOptions.BitmapInterpolationMode="None"
                Source="{Binding Preview}"
                Stretch="Uniform" />
          </Border>

          <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding !IsRecording}">
            <Button
                Command="{Binding RecordNeutralCommand}"
                Content="Record Neutral"
                IsEnabled="{Binding !IsBusy}" />
            <Button
                Command="{Binding RecordSpeechCommand}"
                Content="Record Speech"
                IsEnabled="{Binding !IsBusy}" />
            <Button Command="{Binding OpenDatasetFolderCommand}" Content="Open Folder" />
          </StackPanel>

          <Button
              Command="{Binding StopRecordingCommand}"
              Content="Stop Recording"
              IsVisible="{Binding IsRecording}" />

          <TextBlock
              FontWeight="SemiBold"
              IsVisible="{Binding RecordingStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Text="{Binding RecordingStatus}"
              TextWrapping="Wrap" />

          <TextBlock
              Opacity="0.7"
              TextWrapping="Wrap"
              Text="Neutral: let your face rest for about 45 seconds. Speech: talk naturally for a minute. Wear the headset the way you normally do - just record across a few separate sittings, so the model sees the small shifts that happen anyway when you take it off and put it back on." />
        </StackPanel>
      </controls:ContentExample>

      <!-- ====================== GUIDED CALIBRATION ===================== -->
      <!--
        The only place the dataset gets a correct *non-zero* label. Neutral recordings teach the
        model what rest looks like; this teaches it what a genuine jaw opening looks like, which is
        the other half of telling those two apart.
      -->
      <controls:ContentExample>
        <StackPanel Spacing="10">
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="Guided calibration" />

          <TextBlock
              Opacity="0.7"
              TextWrapping="Wrap"
              Text="Your avatar opens its jaw by a set amount and you copy it. Because the app chose the amount, it knows what your face should have been doing - which is the one thing plain recordings cannot tell it. Put your headset on and watch your avatar in a mirror before starting." />

          <StackPanel IsVisible="{Binding !IsGuidedRunning}" Orientation="Horizontal" Spacing="12">
            <Button
                Command="{Binding StartGuidedJawCalibrationCommand}"
                Content="Start jaw calibration (~1 min)"
                IsEnabled="{Binding CanStartGuided}" />
          </StackPanel>

          <StackPanel IsVisible="{Binding IsGuidedRunning}" Spacing="8">
            <TextBlock
                FontSize="20"
                FontWeight="SemiBold"
                Text="{Binding GuidedInstruction}"
                TextWrapping="Wrap" />
            <ProgressBar Maximum="100" Minimum="0" Value="{Binding GuidedProgress}" />
            <Button Command="{Binding StopGuidedCalibrationCommand}" Content="Stop" />
          </StackPanel>

          <TextBlock
              IsVisible="{Binding GuidedStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Text="{Binding GuidedStatus}"
              TextWrapping="Wrap" />
        </StackPanel>
      </controls:ContentExample>

      <!-- ======================= QUICK CORRECTION ====================== -->
      <!--
        A primary control, not an Advanced one. This is the loop the user runs while actually
        wearing the headset: notice the avatar's jaw hanging open, say so, carry on. It lives here
        rather than under Advanced because it is used far more often than anything below it.
      -->
      <controls:ContentExample>
        <StackPanel Spacing="10">
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="Quick correction" />

          <TextBlock
              Opacity="0.7"
              TextWrapping="Wrap"
              Text="If your avatar's mouth hangs open while your real mouth is closed, press this straight afterwards. It saves the last few seconds as an example of what the tracker got wrong." />

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button
                Command="{Binding FlagMouthClosedCommand}"
                Content="My mouth was closed"
                IsEnabled="{Binding CanFlagCorrection}" />
            <ComboBox
                ItemsSource="{Binding CorrectionWindows}"
                SelectedIndex="{Binding SelectedCorrectionWindowIndex}"
                VerticalAlignment="Center"
                Width="150" />
          </StackPanel>

          <TextBlock
              FontWeight="SemiBold"
              IsVisible="{Binding CorrectionStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Text="{Binding CorrectionStatus}"
              TextWrapping="Wrap" />

          <TextBlock
              IsVisible="{Binding CanFlagCorrection}"
              Opacity="0.7"
              TextWrapping="Wrap"
              Text="{Binding SavedCorrectionCount, StringFormat='Corrections saved so far: {0}. They are used the next time you train.'}" />

          <TextBlock
              IsVisible="{Binding !CanFlagCorrection}"
              Opacity="0.7"
              TextWrapping="Wrap"
              Text="Start the face camera on the Home page to use quick corrections." />
        </StackPanel>
      </controls:ContentExample>

      <!-- =========================== TRAINING ========================== -->
      <controls:ContentExample>
        <StackPanel Spacing="10">
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="Train" />

          <StackPanel IsVisible="{Binding !IsBusy}" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock VerticalAlignment="Center" Text="Model" Width="70" />
              <ComboBox Width="300" SelectedIndex="{Binding SelectedModelIndex}">
                <ComboBoxItem Content="A - expressions only (recommended)" />
                <ComboBoxItem Content="B - expressions + camera image (experimental)" />
              </ComboBox>
            </StackPanel>
            <TextBlock
                Opacity="0.7"
                Text="{Binding ModelChoiceDescription}"
                TextWrapping="Wrap" />
          </StackPanel>

          <Button
              Command="{Binding TrainCommand}"
              Content="Train My Face Model"
              IsEnabled="{Binding CanTrain}"
              IsVisible="{Binding !IsBusy}" />

          <StackPanel IsVisible="{Binding IsBusy}" Spacing="8">
            <ProgressBar IsIndeterminate="True" />
            <TextBlock FontWeight="SemiBold" Text="{Binding BusyMessage}" TextWrapping="Wrap" />
            <Button Command="{Binding CancelWorkCommand}" Content="Cancel" />
          </StackPanel>

          <StackPanel IsVisible="{Binding HasResult}" Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="{Binding ResultHeadline}" TextWrapping="Wrap" />
            <TextBlock
                IsVisible="{Binding ResultDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Text="{Binding ResultDetail}"
                TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Command="{Binding ToggleDetailsCommand}" Content="Show Details" />
          </StackPanel>

          <Border
              Background="#18000000"
              CornerRadius="4"
              IsVisible="{Binding ShowDetails}"
              MaxHeight="240"
              Padding="8">
            <ScrollViewer>
              <SelectableTextBlock
                  FontFamily="Consolas,Menlo,monospace"
                  FontSize="11"
                  Text="{Binding DetailLog}" />
            </ScrollViewer>
          </Border>
        </StackPanel>
      </controls:ContentExample>

      <!-- ========================== COMPARISON ========================= -->
      <controls:ContentExample>
        <StackPanel Spacing="10">
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="Compare" />

          <TextBlock
              FontWeight="SemiBold"
              IsVisible="{Binding ActiveModelName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
              Text="{Binding ActiveModelName}"
              TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="12">
            <RadioButton
                Content="Stock"
                GroupName="ModelChoice"
                IsChecked="{Binding !PersonalModelEnabled}" />
            <RadioButton
                Content="Personal"
                GroupName="ModelChoice"
                IsChecked="{Binding PersonalModelEnabled}" />
          </StackPanel>

          <TextBlock
              Opacity="0.7"
              TextWrapping="Wrap"
              Text="Switch between the two while pulling faces, or while talking to someone in VRChat. Stock is always available - nothing you do here can break normal tracking." />

          <CheckBox Content="Advanced" IsChecked="{Binding ShowAdvanced}" />

          <StackPanel IsVisible="{Binding ShowAdvanced}" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock VerticalAlignment="Center" Text="Strength" Width="70" />
              <Slider
                  Width="240"
                  Maximum="100"
                  Minimum="0"
                  TickFrequency="25"
                  Value="{Binding PersonalStrength}" />
              <TextBlock
                  VerticalAlignment="Center"
                  Text="{Binding PersonalStrength, StringFormat='{}{0:F0}%'}" />
            </StackPanel>
            <TextBlock
                Opacity="0.7"
                TextWrapping="Wrap"
                Text="0% is exactly the stock model, 100% is fully personalized. Useful for blending in a model you are not yet sure about." />

            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Command="{Binding ReloadModelCommand}" Content="Reload Model" />
            </StackPanel>

            <CheckBox Content="Sort by largest change" IsChecked="{Binding SortByDelta}" />

            <Grid ColumnDefinitions="180,70,70,70">
              <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Expression" />
              <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Stock" />
              <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Personal" />
              <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Delta" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Comparison}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="180,70,70,70">
                    <TextBlock Grid.Column="0" Text="{Binding Name}" />
                    <TextBlock Grid.Column="1" Text="{Binding Stock, StringFormat='{}{0:F2}'}" />
                    <TextBlock Grid.Column="2" Text="{Binding Personal, StringFormat='{}{0:F2}'}" />
                    <TextBlock Grid.Column="3" Text="{Binding Delta, StringFormat='{}{0:+0.00;-0.00; 0.00}'}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </controls:ContentExample>

    </StackPanel>
  </ScrollViewer>
</UserControl>
