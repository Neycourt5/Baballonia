<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>

    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.4" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.4" />
    <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.1.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.1.0" />

      <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260302" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Baballonia.CaptureBin.IO\Baballonia.CaptureBin.IO.csproj" />
    <ProjectReference Include="..\Baballonia.IPCameraCapture\Baballonia.IPCameraCapture.csproj" />
    <ProjectReference Include="..\Baballonia.OpenCVCapture\Baballonia.OpenCVCapture.csproj" />
    <ProjectReference Include="..\Baballonia\Baballonia.csproj" />
      <ProjectReference Include="..\Baballonia.Desktop\Baballonia.Desktop.csproj" />
  </ItemGroup>

    <ItemGroup>
        <Reference Include="OpenCvSharp">
            <HintPath>..\..\..\opencvsharp\src\OpenCvSharp\bin\Debug\net6.0\OpenCvSharp.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <None Update="Firmware\Windows\espflash.exe">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="OverlayTests\user_cal.bin">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <!-- Personal-adapter fixtures: small random-weight models exported by training/, used to
             test the real ONNX load/validate/inference path rather than a mock. -->
        <None Update="Assets\PersonalModels\*.onnx">
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

    <!-- Compile the dependency-free module route contract into this test assembly, and copy the
         package metadata so tests verify the same files that the module zip target consumes. -->
    <ItemGroup>
        <Compile Include="..\VRCFaceTracking.Baballonia\ExpressionMapping.cs"
                 Link="ModuleContract\ExpressionMapping.cs" />
        <None Include="..\VRCFaceTracking.Baballonia\BabbleConfig.json"
              Link="ModulePackage\BabbleConfig.json"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\VRCFaceTracking.Baballonia\module.json"
              Link="ModulePackage\module.json"
              CopyToOutputDirectory="PreserveNewest" />
        <None Include="..\VRCFaceTracking.Baballonia\VRCFaceTracking.Baballonia.csproj"
              Link="ModulePackage\VRCFaceTracking.Baballonia.csproj"
              CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Firmware\Linux\" />
        <Folder Include="Firmware\MacOS\" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="..\Baballonia\eyeModel.onnx" />
        <EmbeddedResource Include="..\Baballonia\eyeModel.onnx">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </EmbeddedResource>
        <None Remove="..\Baballonia\faceModel.onnx" />
        <EmbeddedResource Include="..\Baballonia\faceModel.onnx">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <None Update="..\Baballonia.Desktop\Calibration\Windows\onnxruntime.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <None Update="..\Baballonia.Desktop\Calibration\Windows\onnxruntime_providers_shared.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>
