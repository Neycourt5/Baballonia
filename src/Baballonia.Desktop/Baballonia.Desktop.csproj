<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!--If you are willing to use Windows/MacOS native APIs you will need to create 3 projects.
        One for Windows with net10.0-windows TFM, one for MacOS with net10.0-macos and one with net10.0 TFM for Linux.-->
        <TargetFramework>net10.0</TargetFramework>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationIcon>Assets\IconOpaque.ico</ApplicationIcon>
        <Company>Paradigm Reality Enhancement Labs</Company>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyVersion></AssemblyVersion>
        <FileVersion></FileVersion>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

	<PropertyGroup Condition=" '$(OS)' == 'Windows_NT' ">
	  <DefineConstants>WINDOWS</DefineConstants>
	</PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
        <!-- Override Avalonia's transitive Tmds.DBus.Protocol 0.21.2 (GHSA-xrw6-gwf8-vvr9). 0.21.3 is the backported fix. -->
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
        <PackageReference Include="Velopack" Version="0.0.1298" />

        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="11.3.12" />
        <PackageReference Include="Avalonia.Skia" Version="11.3.12" />
        <PackageReference Include="SkiaSharp" Version="3.119.2" />

	    <!-- Windows-specific -->
        <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260302" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
	    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.3" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
        <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.2" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
		<PackageReference Include="DirectShowLib" Version="1.0.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
        <!-- Microphone capture for the optional audio expression assist. Windows-only, and the
             feature degrades to "unavailable" everywhere else rather than failing to build. -->
        <PackageReference Include="NAudio" Version="2.3.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />

        <!-- macOS-specific -->
        <PackageReference Include="OpenCvSharp4.runtime.osx.10.15-universal" Version="4.7.0.20230224" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
	    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
        <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="3.119.0" Condition="$([MSBuild]::IsOSPlatform('OSX'))" />

        <!-- Linux-specific -->
        <PackageReference Include="Project-Babble.OpenCvSharp4.mini.runtime.ubuntu.22.04-x64" Version="4.11.0.2" Condition="$([MSBuild]::IsOSPlatform('Linux')) And
             !($([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().Contains('Arm')))" />

        <PackageReference Include="Project-Babble.OpenCvSharp4.mini.runtime.ubuntu.22.04-arm64" Version="4.11.0.2" Condition="$([MSBuild]::IsOSPlatform('Linux')) And
             $([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().Contains('Arm'))" />
	    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.22.0" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.0" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />

        <!-- App-local ICU (Linux only). .NET uses system ICU on Linux by default, but Steam Linux
             Runtime 4.0 ships no libicui18n, so globalization init FailFasts/SIGABRTs at startup
             before any app code runs. Bundle ICU and point the runtime at it (value must match the
             package's .so version suffix, e.g. libicudata.so.72.1.0.3). macOS uses system ICU (this
             metapackage has no osx runtime) and Windows ships ICU in-box, so this is Linux-scoped. -->
        <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
        <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Trim="false" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
        <PackageReference Include="Xaml.Behaviors.Interactions.Draggable" Version="11.3.9.5" />
        <ProjectReference Include="..\Baballonia.LibV4L2Capture\Baballonia.LibV4L2Capture.csproj" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Baballonia.CaptureBin.IO\Baballonia.CaptureBin.IO.csproj" />
        <ProjectReference Include="..\Baballonia.OpenCVCapture\Baballonia.OpenCVCapture.csproj" />
        <ProjectReference Include="..\Baballonia.SDK\Baballonia.SDK.csproj" />
        <ProjectReference Include="..\Baballonia.SerialCameraCapture\Baballonia.SerialCameraCapture.csproj" />
        <ProjectReference Include="..\Baballonia.IPCameraCapture\Baballonia.IPCameraCapture.csproj" />
        <ProjectReference Include="..\Baballonia.VFTCapture\Baballonia.VFTCapture.csproj" />
        <ProjectReference Include="..\Baballonia\Baballonia.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="assets\BannerOpaque_90x58.png">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="assets\BannerOpaque_175x345.png">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="assets\Icon_32x32.ico">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="assets\Icon_512x512.png">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="assets\IconOpaque_32x32.ico">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="assets\IconOpaque_32x32.png">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="assets\IconOpaque.ico">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="assets\MUI_HEADERIMAGE_BITMAP.bmp">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="assets\MUI_WELCOMEFINISHPAGE_BITMAP.bmp">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="assets\license.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="baseline_L.pth">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="baseline_R.pth">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="Calibration\Linux\**\*" Condition="$([MSBuild]::IsOSPlatform('Linux'))">
          <Link>%(RecursiveDir)\%(Filename)%(Extension)</Link>
          <TargetPath>%(RecursiveDir)\%(Filename)%(Extension)</TargetPath>
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <!-- _internal is a local CUDA PyInstaller bundle (~7.8GB) that must never ship (CI builds
           contain only the single BabbleTrainer file). It is a SYMLINK-to-directory, which MSBuild
           enumerates as a file-like item; copying it raises MSB3024. Remove both the symlink item
           itself AND anything under it. -->
      <None Remove="Calibration\Linux\Trainer\_internal" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
      <None Remove="Calibration\Linux\Trainer\_internal\**" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
      <!-- The public 1.5.2 trainer is self-contained. Legacy NPZ/PT training assets stay
           in source; the distribution only needs its executable and the overlay runtime. -->
      <None Update="Calibration\Windows\Trainer\BabbleTrainer.exe;Calibration\Windows\Overlay\**\*" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
          <Link>%(RecursiveDir)\%(Filename)%(Extension)</Link>
          <TargetPath>%(RecursiveDir)\%(Filename)%(Extension)</TargetPath>
          <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="onnx_artifacts\training\checkpoint\paramfrozen_tensors.pbseq">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="onnx_artifacts\training\checkpoint\paramtrain_tensors.pbseq">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="onnx_artifacts\training\eval_model.onnx">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="onnx_artifacts\training\optimizer_model.onnx">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="onnx_artifacts\training\training_model.onnx">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="onnx_artifacts\baball_model.onnx">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="onnx_artifacts\temporal_eye_tracking_model.onnx">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

    <Target Name="CopyModulesToFolder" AfterTargets="AfterBuild">
        <!-- TargetDir has a trailing separator even when building to a custom output directory. -->
        <ItemGroup>
            <ModuleDlls Condition="Exists('$(TargetDir)Baballonia.LibV4L2Capture.dll')" Include="$(TargetDir)Baballonia.LibV4L2Capture.dll" />
            <ModuleDlls Condition="Exists('$(TargetDir)Baballonia.SerialCameraCapture.dll')" Include="$(TargetDir)Baballonia.SerialCameraCapture.dll" />
            <ModuleDlls Condition="Exists('$(TargetDir)Baballonia.OpenCVCapture.dll')" Include="$(TargetDir)Baballonia.OpenCVCapture.dll" />
            <ModuleDlls Condition="Exists('$(TargetDir)Baballonia.IPCameraCapture.dll')" Include="$(TargetDir)Baballonia.IPCameraCapture.dll" />
            <ModuleDlls Condition="Exists('$(TargetDir)Baballonia.VFTCapture.dll')" Include="$(TargetDir)Baballonia.VFTCapture.dll" />
            <ModuleDlls Condition="Exists('$(TargetDir)Baballonia.LibV4L2Capture.pdb')" Include="$(TargetDir)Baballonia.LibV4L2Capture.pdb" />
            <ModuleDlls Condition="Exists('$(TargetDir)Baballonia.SerialCameraCapture.pdb')" Include="$(TargetDir)Baballonia.SerialCameraCapture.pdb" />
            <ModuleDlls Condition="Exists('$(TargetDir)Baballonia.OpenCVCapture.pdb')" Include="$(TargetDir)Baballonia.OpenCVCapture.pdb" />
            <ModuleDlls Condition="Exists('$(TargetDir)Baballonia.IPCameraCapture.pdb')" Include="$(TargetDir)Baballonia.IPCameraCapture.pdb" />
            <ModuleDlls Condition="Exists('$(TargetDir)Baballonia.VFTCapture.pdb')" Include="$(TargetDir)Baballonia.VFTCapture.pdb" />
        </ItemGroup>
        <Move SourceFiles="@(ModuleDlls)" DestinationFolder="$(TargetDir)Modules\" />
    </Target>
    <!-- Use PublishDir so explicit output directories retain discoverable camera modules. -->
    <Target Name="CopyModulesToFolderPublish" AfterTargets="Publish">
        <ItemGroup>
            <PublishModuleDlls Condition="Exists('$(PublishDir)Baballonia.SerialCameraCapture.dll')" Include="$(PublishDir)Baballonia.SerialCameraCapture.dll" />
            <PublishModuleDlls Condition="Exists('$(PublishDir)Baballonia.OpenCVCapture.dll')" Include="$(PublishDir)Baballonia.OpenCVCapture.dll" />
            <PublishModuleDlls Condition="Exists('$(PublishDir)Baballonia.IPCameraCapture.dll')" Include="$(PublishDir)Baballonia.IPCameraCapture.dll" />
            <PublishModuleDlls Condition="Exists('$(PublishDir)Baballonia.VFTCapture.dll')" Include="$(PublishDir)Baballonia.VFTCapture.dll" />
            <PublishModuleDlls Condition="Exists('$(PublishDir)Baballonia.LibV4L2Capture.dll')" Include="$(PublishDir)Baballonia.LibV4L2Capture.dll" />
        </ItemGroup>
        <Move SourceFiles="@(PublishModuleDlls)" DestinationFolder="$(PublishDir)Modules\" />
    </Target>

    <!--
        Ship the personalization training scripts beside the app.

        The Personalization page locates them by walking up from the executable's folder, which
        works when running from the source tree but not from a published build. Copying them into
        the publish output keeps "Train My Face Model" working for an installed copy. They are a few
        small text files; the heavy dependency (PyTorch) is still installed separately, on demand,
        into the user's own environment.
    -->
    <Target Name="CopyPersonalizationTrainingScripts" AfterTargets="Publish">
        <ItemGroup>
            <PersonalizationPythonFiles Include="$(MSBuildThisFileDirectory)..\..\training\babble_personal\**\*.py" />
            <PersonalizationSupportingFiles Include="$(MSBuildThisFileDirectory)..\..\training\requirements.txt;$(MSBuildThisFileDirectory)..\..\training\README.md" />
        </ItemGroup>
        <Copy SourceFiles="@(PersonalizationPythonFiles)"
              DestinationFiles="@(PersonalizationPythonFiles->'$(PublishDir)training\babble_personal\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"
              Condition="'@(PersonalizationPythonFiles)' != ''" />
        <Copy SourceFiles="@(PersonalizationSupportingFiles)"
              DestinationFiles="@(PersonalizationSupportingFiles->'$(PublishDir)training\%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"
              Condition="'@(PersonalizationSupportingFiles)' != ''" />
    </Target>

    <!-- SkiaSharp is currently broken on ARM for some reason -->
    <Target Name="PatchSkiaSharp" Condition="$([MSBuild]::IsOSPlatform('Linux')) And $(RuntimeIdentifier.Contains('arm')) And Exists('$(OutputPath)runtimes\linux-arm64\native\libSkiaSharp.so')" AfterTargets="AfterBuild;AfterPublish">
        <Exec Command="patchelf --add-needed libuuid.so.1 '$(OutputPath)runtimes\linux-arm64\native\libSkiaSharp.so'" />
        <Exec Command="patchelf --add-needed libfreetype.so.6 '$(OutputPath)runtimes\linux-arm64\native\libSkiaSharp.so'" />
    </Target>
    <Target Name="PatchSkiaSharp" Condition="$([MSBuild]::IsOSPlatform('Linux')) And $(RuntimeIdentifier.Contains('arm')) And Exists('$(OutputPath)libSkiaSharp.so')" AfterTargets="AfterBuild;AfterPublish">
        <Exec Command="patchelf --add-needed libuuid.so.1 '$(OutputPath)libSkiaSharp.so'" />
        <Exec Command="patchelf --add-needed libfreetype.so.6 '$(OutputPath)libSkiaSharp.so'" />
    </Target>

</Project>
